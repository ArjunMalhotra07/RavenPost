[Unit]
Description=Print Server (FastAPI)
After=network.target cups.service
Requires=cups.service

[Service]
Type=simple
User=pi
Group=lpadmin
WorkingDirectory=/home/pi/print-server
EnvironmentFile=/home/pi/print-server/.env
ExecStart=/home/pi/print-server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/print-server/uploads
PrivateTmp=true

[Install]
WantedBy=multi-user.target
